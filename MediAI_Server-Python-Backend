import asyncio
import json
from pathlib import Path

from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
import uvicorn

app = FastAPI(title="MEDI API")

BASE_DIR = Path(__file__).resolve().parent

FRONTEND_DIR = BASE_DIR / "frontend"

INDEX_FILE = FRONTEND_DIR / "medi-frontend.html"

medi_state = {
    "status": "offline",

    "user_message": "",

    "agent_message": "",

    "patient":{
        "main_concern": None,
        "symptoms":[],
        "duration":None,
        "severity":None,
        "location":None,
        "associated_symptoms":[],
        "medications":[],
        "allergies":[],
        "medical_history":[],
        "notes":[],
    }

}

connected_clients = set()

if FRONTEND_DIR.exists():

    app.mount(
        "/static",
        StaticFiles(directory=FRONTEND_DIR),
        name="static"
    )

@app.get("/")
async def home():

    if not INDEX_FILE.exists():

        return {
            "error": "Frontend hasnt been found bruh!",
            "expected": str(INDEX_FILE)
        }

    return FileResponse(INDEX_FILE)

@app.get("/api/health")
async def health():

    return{
        "status": "online",
        "medi_status":medi_state["status"]
    }

async def send_to_client(
        websocket: WebSocket,
        message: dict
):

    try:

        await websocket.send_json(message)

    except Exception:

        pass

async def broadcast(message: dict):

    disconnected = []

    for websocket in connected_clients:

        try:

            await websocket.send_json(message)

        except Exception:

            disconnected.append(websocket)

    for websocket in disconnected:

        connected_clients.discard(websocket)

async def update_status(status:str):

    medi_state["status"] = status

    await broadcast(
        {
            "type":"status",

            "status": status
        }
    )

async def send_user_transcript(text:str):

    medi_state["user_message"] = text
    await broadcast(
        {
            "type": "transcript",

            "role": "user",

            "text": text
        }
    )


async def send_agent_transcript(text: str):

    medi_state["agent_message"] = text

    await broadcast(
        {
            "type":"transcript",

            "role": "assistant",

            "text": text
        }
    )

async def send_patient_update(patient_data: dict):

    medi_state["patient"].update(
        patient_data
    )

    await broadcast(
        {
            "type": "patient_update",

            "data": medi_state["patient"]
        }
    )

@app.websocket("/ws")

async def websocket_endpoint(
        websocket: WebSocket
):

    await websocket.accept()

    connected_clients.add(websocket)

    print(
        "\n[SERVER] Frontend connected"
    )

    await send_to_client(
        websocket,
        {
            "type":"state",

            "data":medi_state
        }
    )

    try:

        while True:

            message = await websocket.receive_json()

            print(
                "\n[FRONTEND]",
                message
            )

            await handle_frontend_message(
                websocket,
                message
            )

    except WebSocketDisconnect:

        print(
            "/n[SERVER] Frontend disconnected!"
        )

    except Exception as error:

        print(
            "/n[SERVER ERROR]",
            error
        )

    finally:

        connected_clients.discard(
            websocket
        )

async def handle_frontend_message(
        websocket: WebSocket,
        message: dict
):

    command = message.get(
        "type"
    )

    if command == "start":

        print(
            "[MEDI] Start requested."
        )

        await update_status(
            "starting"
        )

        await update_status(
            "listening"
        )

    elif command == "stop":

        print(
            "[MEDI] Stop requested."
        )

        await update_status(
            "offline"
        )

    elif command == "interrupt":

        print(
            "[MEDI] Interrupt requested."
        )

        await update_status(
            "listening"
        )

    elif command == "get_state":

        await send_to_client(
            websocket,

            {
                "type": "state",

                "data":medi_state
            }
        )

    elif command == "test":

        await send_to_client(
            websocket,

            {
                "type":"test",

                "message": "MEDI server is working bro!!!"
            }
        )

    else:

        await send_to_client(
            websocket,

            {
                "type": "error",

                "message":f"Unknown command: {command}"
            }
        )

