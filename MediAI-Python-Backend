async def send_audio(ws, microphone):

    await session_ready.wait()

    microphone.start()

    status("Listening......")

    while running:

        if not running:
            break

        audio = await asyncio.to_thread(
            microphone.get
        )

        message = {
            "type": "input.audio",
            "audio": base64.b64encode(
                audio
            ).decode("ascii")
        }

        await ws.send(
            json.dumps(message)
        )

async def receive_events(
        ws,
        speaker
):
    global session_id
    global agent_speaking
    global current_user_transcript
    global current_agent_transcript

    pending_tools = []

    async for raw in ws:

        event = json.loads(raw)

        event_type = event.get("type")


        if event_type == "session.ready":

            session_id = event.get(
                "session_id"
            )

            session_ready.set()

            status(
                "Online. Tell me what you are experiencing.!"
            )

        elif event_type == "input.speech.started":

            print("\nYou are speaking...")

        elif event_type  == "input.speech.stopped":

            print(f"\n SPEECH HAS STOPPED: {time.perf_counter():.3f}")

            print("\nProcessing...")

        elif event_type == "transcript.user.delta":

            text = event.get(
                "text",
                ""
            )

            current_user_transcript = text

            print(
                f"\rYou: {text}",
                end="",
                flush=True
            )

        elif event_type == "transcript.user":

            text = event.get(
                "text",
                ""
            ).strip()

            if text:

                conversation.append(
                    {
                        "role": "user",
                        "text": text,
                        "timestamp": time.time()
                    }
                )

                print(
                    f"\rYou: {text}"
                    + " " * 25
                )

                push_frontend({
                    "type": "transcript",
                    "role": "user",
                    "text": text
                })

        elif event_type == "reply.started":

            print(f"\n REPLY HAS BEEN STARTED: {time.perf_counter():.3f}")

            agent_speaking = True

            current_agent_transcript = ""

            print(
                "\nMEDI: ",
                end="",
                flush=True
            )

        elif event_type == "reply.audio":

            audio_data = event.get("data")

            if audio_data:

                pcm = base64.b64decode(
                    audio_data
                )

                speaker.play(pcm)


        elif event_type == "transcript.agent":

            text = event.get(
                "text",
                ""
            ).strip()

            if text:

                current_agent_transcript = text

                print(
                    f"\rMEDI: {text}"
                )

                conversation.append(
                    {
                        "role": "assistant",
                        "text": text,
                        "timestamp": time.time()
                    }
                )

        elif event_type == "tool.call":

            call_id = event.get(
                "call_id"
            )

            name = event.get(
                "name"
            )

            arguments = event.get(
                "arguments",
                {}
            )

            print(
                f"\n[TOOL] {name}"
            )

            print(
                f"[TOOL DATA] {arguments}"
            )

            result = handle_tool(
                name,
                arguments
            )

            pending_tools.append(
                {
                    "call_id": call_id,
                    "result": result
                }
            )

        elif event_type == "reply.done":

            agent_speaking = False

            status_value = event.get("status")

            if status_value == "interrupted":

                print("\n[MEDI] Interrupted")

                pending_tools.clear()

                speaker.flush_and_restart()



            else:

                for tool in pending_tools:

                    message = {
                        "type": "tool.result",
                        "call_id": tool["call_id"],
                        "result": json.dumps(tool["result"])
                    }

                    await ws.send(
                        json.dumps(message)
                    )


                pending_tools.clear()



        elif event_type == "session.updated":

            print(
                "\n[MEDI] Session updated."
            )

        elif event_type == "session.error":

            print(
                "\n[ASSEMBLYAI ERROR!]"
            )

            print(
                event
            )

        else:

            if event_type:

                print(
                    f"\n[EVENT] {event_type}"
                )

async def run_medi():

    microphone = Microphone()

    speaker = Speaker()

    headers = {
        "Authorization": f"Bearer {API_KEY}"
    }

    banner()

    print("Connecting to AssemblyAI.....")

    try:
         async with websockets.connect(
             WS_URL,
             additional_headers=headers,
             open_timeout=30,
             ping_interval=20,
             ping_timeout=20,
             max_size=None
         ) as ws:
             await ws.send(
                 json.dumps(
                     {
                         "type": "session.update",

                         "session": {

                             "system_prompt":
                                 SYSTEM_PROMPT,

                             "greeting":
                                 (
                                     "Hi, I am MEDI."
                                     "Tell me what you are experiencing, "
                                     "and i will help you organize the"
                                     "information."
                                 ),

                             "tools":
                               TOOLS,

                             "input":{
                                 "turn_detection":{
                                     "interrupt_response": True
                                 }
                             },

                             "output":
                                 {
                                     "voice": VOICE
                                 }
                         }
                     }
                 )
             )

             await asyncio.gather(

                 send_audio(
                     ws,
                     microphone,
                 ),

                 receive_events(
                     ws,
                     speaker
                 )
             )
    finally:

        microphone.stop()

        speaker.stop()

