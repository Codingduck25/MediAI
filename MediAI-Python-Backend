class Microphone:

    def __init__(self):

        self.queue = queue.Queue(maxsize=20)

        self.stream = None

        self.active = False

    def callback(
            self,
            indata,
            _frames,
            _time_info,
            status
    ):

        if status:
            print(f"\n[MIC] {status}")

        if not self.active:
            return

        audio = indata.copy().tobytes()

        try:

            self.queue.put_nowait(audio)

        except queue.Full:

            pass

    def start(self):

        if self.active:
            return

        self.active = True

        self.stream = sd.InputStream(
            samplerate=SAMPLE_RATE,
            channels=CHANNELS,
            dtype="int16",
            blocksize=CHUNK_SAMPLES,
            callback=self.callback
        )

        self.stream.start()

    def stop(self):

        self.active = False

        if self.stream:

            self.stream.stop()

            self.stream.close()

            self.stream = None

    def get(self):

        return self.queue.get()

class Speaker:

    def __init__(self):

        self.stream = sd.OutputStream(
            samplerate=SAMPLE_RATE,
            channels=CHANNELS,
            dtype="int16",
            blocksize=CHUNK_SAMPLES
        )

        self.stream.start()

    def play(self, pcm_bytes):

        if not pcm_bytes:
            return

        audio = np.frombuffer(
            pcm_bytes,
            dtype=np.int16
        )

        try:

            self.stream.write(audio)

        except Exception as error:

            print(
                f"\n[AUDIO ERROR] {error}"
            )




    def flush_and_restart(self):

        try:

            self.stream.abort()
            self.stream.close()

        except Exception:

            pass

        self.stream = sd.OutputStream(
            samplerate=SAMPLE_RATE,
            channels=CHANNELS,
            dtype="int16",
            blocksize=CHUNK_SAMPLES
        )

        self.stream.start()

    def stop(self):

        try:

            self.stream.abort()
            self.stream.close()

        except Exception:

            pass


