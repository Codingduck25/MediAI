@app.websocket("/ws")
async def frontend_websocket(websocket: WebSocket):

    await websocket.accept()

    global frontend_loop
    frontend_loop = asyncio.get_running_loop()


    connected_clients.add(websocket)

    print("\n[SERVER] Frontend connected")

    await websocket.send_json({
        "type":"state",
        "data":medi_state
    })

    try:

        while True:

            message = await websocket.receive_json()

            print("[FRONTEND]", message)

            command = message.get("type")

            if command == "start":

                push_frontend({
                    "type": "status",
                    "status": "listening"
                })

                await broadcast_frontend({
                    "type": "status",
                    "status":"listening"
                })

            elif command == "stop":

                medi_state["status"] = "ready"

                await broadcast_frontend({
                    "type":"status",
                    "status":"ready"
                })

            elif command == "interrupt":

                await broadcast_frontend({
                    "type":"status",
                    "status":"listening"
                })

            elif command == "get_state":

                await websocket.send_json({
                    "type":"state",
                    "data":medi_state
                })

            elif command == "test":

                await websocket.send_json({
                    "type":"test",
                    "message":"MEDI server is working bro!"
                })

    except WebSocketDisconnect:

        print("\n[SERVER] Frontend disconnected")

    finally:

        connected_clients.discard(websocket)

frontend_loop = None

def push_frontend(message):
    if frontend_loop is not None:
        asyncio.run_coroutine_threadsafe(
            broadcast_frontend(message),
            frontend_loop
        )


async def broadcast_frontend(message):

    dead = []

    for websocket in connected_clients:

        try:
            await websocket.send_json(message)

        except Exception:
            dead.append(websocket)

    for websocket in dead:
        connected_clients.discard(websocket)



